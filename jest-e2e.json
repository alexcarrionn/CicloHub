{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "roots": ["<rootDir>/apps/"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/contratos(|/.*)$": "<rootDir>/libs/contratos/src/$1",
    "^@app/shared(|/.*)$": "<rootDir>/libs/shared/src/$1"
  }
}
