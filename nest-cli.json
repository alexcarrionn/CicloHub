{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/gateway",
  "projects": {
    "contratos": {
      "type": "library",
      "root": "libs/contratos",
      "entryFile": "index",
      "sourceRoot": "libs/contratos/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contratos/tsconfig.lib.json"
      }
    },
    "estaciones-bici": {
      "type": "application",
      "root": "apps/estaciones-bici",
      "entryFile": "main",
      "sourceRoot": "apps/estaciones-bici/src",
      "compilerOptions": {
        "tsConfigPath": "apps/estaciones-bici/tsconfig.app.json"
      }
    },
    "estadisticas": {
      "type": "application",
      "root": "apps/estadisticas",
      "entryFile": "main",
      "sourceRoot": "apps/estadisticas/src",
      "compilerOptions": {
        "tsConfigPath": "apps/estadisticas/tsconfig.app.json"
      }
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "incidencias": {
      "type": "application",
      "root": "apps/incidencias",
      "entryFile": "main",
      "sourceRoot": "apps/incidencias/src",
      "compilerOptions": {
        "tsConfigPath": "apps/incidencias/tsconfig.app.json"
      }
    },
    "prestamos": {
      "type": "application",
      "root": "apps/prestamos",
      "entryFile": "main",
      "sourceRoot": "apps/prestamos/src",
      "compilerOptions": {
        "tsConfigPath": "apps/prestamos/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    },
    "usuarios": {
      "type": "application",
      "root": "apps/usuarios",
      "entryFile": "main",
      "sourceRoot": "apps/usuarios/src",
      "compilerOptions": {
        "tsConfigPath": "apps/usuarios/tsconfig.app.json"
      }
    }
  }
}
